// Prisma schema — Exam Prep Platform
// Postgres via Neon. Run `npx prisma migrate dev` once DATABASE_URL is set.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth (NextAuth Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  MODERATOR
  MENTOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(USER)
  telegramId    String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  resources       Resource[]
  questions       Question[]
  comments        Comment[]
  commentUpvotes  CommentUpvote[]
  mentorProfile   MentorProfile?
  bookingsAsMentee Booking[]      @relation("MenteeBookings")
  verifiedMentors  MentorProfile[] @relation("MentorVerifier")
  paymentsVerified Booking[]      @relation("PaymentVerifier")
  payoutsPaid      Payout[]       @relation("PayoutAdmin")

  @@index([role])
}

// ---------- Resources ----------

model Resource {
  id         String   @id @default(cuid())
  title      String
  url        String
  category   String // institute | books | test-series | pyq — see config/site.ts
  subject    String // "physics" now, extensible
  tags       String[]
  pinned     Boolean  @default(false)
  featured   Boolean  @default(false)
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([subject, category])
}

// ---------- Community Q&A ----------

model Question {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  imageUrl  String?
  subject   String
  pinned    Boolean   @default(false)
  locked    Boolean   @default(false)
  deleted   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]

  @@index([subject])
  @@index([pinned])
}

model Comment {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  upvotes    Int      @default(0)
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now())

  votes CommentUpvote[]

  @@index([questionId])
}

model CommentUpvote {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

// ---------- Mentor marketplace ----------

model MentorProfile {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute  String
  rank       String? // e.g. AIR / rank proof text
  subjects   String[]
  rate       Int // per-session rate, INR
  upiId      String // for manual payment collection
  proofUrl   String // uploaded proof document (Supabase Storage)
  bio        String?   @db.Text
  verified   Boolean   @default(false)
  verifiedBy String?
  verifier   User?     @relation("MentorVerifier", fields: [verifiedBy], references: [id])
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  availability Availability[]
  bookings     Booking[]

  @@index([verified])
}

model Availability {
  id        String        @id @default(cuid())
  mentorId  String
  mentor    MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  startTime String // "HH:mm", 24h
  duration  Int           @default(30) // minutes
  isBooked  Boolean       @default(false)
  createdAt DateTime      @default(now())

  bookings Booking[]

  @@index([mentorId])
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  COMPLETED
  DISPUTED
  CANCELLED
}

model Booking {
  id     String @id @default(cuid())

  menteeId String
  mentee   User   @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)

  mentorId String
  mentor   MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  slotId String
  slot   Availability @relation(fields: [slotId], references: [id])

  status BookingStatus @default(PENDING_PAYMENT)
  amount Int

  utrReference   String?
  paymentProofUrl String?

  meetLink String?

  paymentVerifiedBy String?
  verifier          User?     @relation("PaymentVerifier", fields: [paymentVerifiedBy], references: [id])
  paymentVerifiedAt DateTime?

  menteeConfirmedHappened Boolean? // post-session "did this happen?" prompt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payout Payout?

  @@index([status])
  @@index([menteeId])
  @@index([mentorId])
}

model Payout {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Int
  paidByAdmin String
  admin       User      @relation("PayoutAdmin", fields: [paidByAdmin], references: [id])
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}
