// Prisma schema — Exam Prep Platform
// Postgres via Neon. Run `npx prisma migrate dev` once DATABASE_URL is set.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth (NextAuth Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  MODERATOR
  MENTOR
  ADMIN
}

// Where the student currently is in their JAM/NET/GATE prep journey —
// shown on their profile and used to tailor mentor matching.
enum AcademicStatus {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FINAL_YEAR
  POST_GRADUATE
  DROPPER
  WORKING_PROFESSIONAL
  OTHER
}

model User {
  id              String          @id @default(cuid())
  email           String?         @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  bio             String?         @db.Text
  collegeName     String?
  academicStatus  AcademicStatus?
  role            Role            @default(USER)
  telegramId      String?         @unique
  firebaseUid     String?         @unique
  termsAcceptedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  accounts Account[]
  sessions Session[]

  resources          Resource[]
  questions          Question[]
  comments           Comment[]
  commentUpvotes     CommentUpvote[]
  mentorProfile      MentorProfile?
  bookingsAsMentee   Booking[]           @relation("MenteeBookings")
  verifiedMentors    MentorProfile[]     @relation("MentorVerifier")
  refundsInitiated   Refund[]            @relation("RefundAdmin")
  payoutsPaid        Payout[]            @relation("PayoutAdmin")
  reports            Report[]
  assessmentAttempts AssessmentAttempt[]
  sessionReviews     SessionReview[]     @relation("ReviewAuthor")
  reviewsHidden      SessionReview[]     @relation("ReviewModerator")
  notifications      Notification[]
  meetingAttendance  MeetingAttendance[]

  @@index([role])
}

// ---------- Resources ----------

model Resource {
  id         String   @id @default(cuid())
  title      String
  url        String
  category   String // institute | books | test-series | pyq — see config/site.ts
  subject    String // "physics" now, extensible
  tags       String[]
  pinned     Boolean  @default(false)
  featured   Boolean  @default(false)
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([subject, category])
}

// ---------- Community Q&A ----------

model Question {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  imageUrl  String?
  subject   String
  pinned    Boolean   @default(false)
  locked    Boolean   @default(false)
  deleted   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]

  @@index([subject])
  @@index([pinned])
}

model Comment {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  upvotes    Int      @default(0)
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now())

  votes CommentUpvote[]

  @@index([questionId])
}

model CommentUpvote {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

// ---------- Mentor marketplace ----------

model MentorProfile {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute  String
  rank       String? // e.g. AIR / rank proof text
  subjects   String[]
  rate       Int // per-session rate, INR — this is exactly what the mentee is charged
  upiId      String // where the admin sends this mentor's payout (mentees never see it)
  proofUrl   String // uploaded proof document (Supabase Storage)
  bio        String?   @db.Text
  verified   Boolean   @default(false)
  verifiedBy String?
  verifier   User?     @relation("MentorVerifier", fields: [verifiedBy], references: [id])
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  availability Availability[]
  bookings     Booking[]
  reviews      SessionReview[]

  // Topic tags (e.g. "Rotational Mechanics"). Kept for admin filtering and
  // future matching — the results page deliberately does NOT rank mentors by
  // these, because claiming a mentor "closed the same gap" is a promise we
  // can't back with data yet.
  topics String[] @default([])

  // --- Conversion fields ---------------------------------------------------
  // A student books a person, not a listing. These carry the three things that
  // actually decide a booking: did they clear MY exam, are they like me, and
  // will they understand me. All are required at application time; the column
  // defaults exist only so the migration can add them to pre-existing rows
  // without a manual backfill step.
  examCleared String   @default("") // which exam they actually cleared, e.g. "JAM Physics"
  examYear    Int      @default(0) // year they cleared it — recency is credibility
  currentRole String   @default("") // "MSc Physics, IIT Bombay" — where it got them
  languages   String[] @default([]) // a student who thinks in Hindi books the Hindi mentor
  story       String   @default("") @db.Text // the "I was where you are" line, in their own words

  // --- Rating rollup ------------------------------------------------------
  // Denormalised on purpose. Every mentor listing (home, /mentors, the study
  // plan's recommendations) renders a rating next to each card; computing it
  // with an aggregate per mentor is the classic N+1 that makes a listing page
  // scale with the number of mentors. These two columns are written inside the
  // same transaction as the review itself — see src/app/reviews/actions.ts —
  // so a listing needs no extra query at all. Sum + count rather than a stored
  // average because both are exact integers and update atomically with
  // `increment`, which a float average can't do without read-modify-write.
  reviewCount Int @default(0) // published reviews only
  ratingSum   Int @default(0) // sum of those reviews' stars

  // The number a listing actually sorts on: a Bayesian-weighted rating, not
  // ratingSum/reviewCount. A raw average lets one 5-star review outrank fifty
  // 4.8s, which is how a brand-new mentor ends up on the front page — exactly
  // the bug this column exists to kill. See src/lib/mentors/rank.ts for the
  // formula and the constants.
  //
  // Written in the SAME statement as the two columns above (one UPDATE, in
  // src/lib/mentors/rollup.ts) so it can never drift from them, and indexed
  // so ORDER BY happens in Postgres rather than over an array in Node.
  ratingScore Float @default(4.5) // = RATING_PRIOR_MEAN for a mentor with no reviews

  // --- Social proof --------------------------------------------------------
  // Paid bookings, counted once when the payment is captured and uncounted
  // only on a full refund. Deliberately NOT "sessions the mentee confirmed
  // happened": that confirmation is a button most students never press, so
  // counting it would show "4 sessions" for a mentor who has taken thirty.
  // Money changing hands is the honest, cheap signal — and it is one integer
  // on this row rather than an aggregate over Booking on every card render.
  paidSessions Int @default(0)

  // --- Curation ------------------------------------------------------------
  // Hand-picked placement on the home page. null = not featured; lower sorts
  // earlier. An Int rather than a boolean because the home page shows three
  // cards and which one leads is a marketing decision, not an alphabetical
  // accident. Set from /admin/mentors.
  featuredRank Int?

  @@index([verified])
  // The two orderings every listing uses. Both lead with `verified` because
  // no public listing ever reads an unverified mentor.
  @@index([verified, ratingScore(sort: Desc)])
  @@index([verified, featuredRank])
}

model Availability {
  id        String        @id @default(cuid())
  mentorId  String
  mentor    MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  startTime String // "HH:mm", 24h
  duration  Int           @default(30) // minutes
  isBooked  Boolean       @default(false)
  createdAt DateTime      @default(now())

  bookings Booking[]

  @@index([mentorId])
}

enum BookingStatus {
  PENDING_PAYMENT // created, slot held, mentee has not paid yet
  PAYMENT_PROCESSING // authorised at Razorpay but not captured (e.g. pending UPI)
  CONFIRMED // captured — safe to run the session
  COMPLETED
  DISPUTED
  CANCELLED // cancelled before payment, or rejected by an admin
  EXPIRED // hold lapsed before payment; slot released
  REFUNDED // money returned to the mentee
}

model Booking {
  id String @id @default(cuid())

  menteeId String
  mentee   User   @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)

  mentorId String
  mentor   MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  slotId String
  slot   Availability @relation(fields: [slotId], references: [id])

  status BookingStatus @default(PENDING_PAYMENT)
  amount Int // INR rupees (Payment.amount is paise — see src/lib/razorpay/money.ts)

  meetLink String?

  /// The one absolute instant this booking's session happens, stored in UTC.
  ///
  /// `Availability` is a recurring weekly pattern ("Thursdays at 18:00 IST"),
  /// which is the right shape for a mentor setting their hours and the wrong
  /// shape for everything downstream: reminders, the meeting-link window and
  /// the completion sweep all have to compare against `now()`, and a weekday
  /// plus "HH:mm" is not a point in time. Resolved exactly once, at booking
  /// creation, by resolveSlotOccurrence() in src/lib/days.ts.
  ///
  /// Never re-derive this from the slot. Re-deriving answers "when does that
  /// weekly slot next fall?", which silently rolls a finished session forward
  /// to next week the moment it passes.
  ///
  /// Nullable only for the bookings that predate this column.
  scheduledStartAt DateTime?

  /// Snapshot of the slot's length, in minutes, as it was when booked. The
  /// mentor can edit or delete the Availability row afterwards; what somebody
  /// already paid for must not change underneath them.
  durationMinutes Int?

  // Deadline for the mentee to pay. Past this, the booking is swept to EXPIRED
  // and the slot is released — see expireStaleHolds() in src/lib/payments/sync.ts.
  expiresAt DateTime?

  // Mentee-initiated cancellation request on an already-paid booking. Refunds
  // are admin-only, so this is a flag for the admin queue, not a state change.
  cancellationRequestedAt DateTime?
  cancellationReason      String?   @db.Text

  menteeConfirmedHappened Boolean? // post-session "did this happen?" prompt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments      Payment[]
  payout        Payout?
  review        SessionReview?
  notifications Notification[]
  attendance    MeetingAttendance[]

  @@index([status])
  @@index([menteeId])
  @@index([mentorId])
  @@index([status, expiresAt])
  // Drives the completion sweep and the "sessions starting soon" queries.
  @@index([status, scheduledStartAt])
}

// ---------- Session feedback ----------

/// One mentee's verdict on one session.
///
/// Keyed on the booking (`@unique`), which is what makes a review here worth
/// more than a review anywhere else: it can only exist if that person actually
/// paid for and sat through that call. There is no "write a review" button
/// anywhere on the site — the only entry point is a session you took.
///
/// A review both edits in place and hides under moderation, so the mentor's
/// rollup (MentorProfile.reviewCount / ratingSum) is maintained transactionally
/// alongside every write. `published` is the moderation switch; a hidden review
/// stays in the table (the author still sees and can fix it) but leaves the
/// rollup and every public surface.
model SessionReview {
  id String @id @default(cuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Denormalised from the booking so the mentor's reviews are one indexed read
  // rather than a join through Booking on every profile view.
  mentorId String
  mentor   MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  rating  Int // 1..5 stars — enforced in the action, not the column
  comment String? @db.Text // optional: a star with no words is still signal

  published   Boolean   @default(true)
  hiddenAt    DateTime?
  hiddenBy    String?
  hiddenByMod User?     @relation("ReviewModerator", fields: [hiddenBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Covers the only public query there is: this mentor's published reviews,
  // newest first. Sorted in the index so pagination never sorts at read time.
  @@index([mentorId, published, createdAt(sort: Desc)])
  @@index([authorId])
}

// ---------- Payments (Razorpay Standard Checkout) ----------

enum PaymentStatus {
  CREATED // order created at Razorpay, mentee has not paid yet
  AUTHORIZED // funds held by Razorpay, not yet captured
  CAPTURED // money confirmed, queued for settlement
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// One Razorpay order. A booking can have several: a fresh order is created if
/// an earlier hold expired and the mentee starts over.
model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  razorpayOrderId   String  @unique
  razorpayPaymentId String? @unique
  receipt           String // our reference, "bk_<bookingId>" (Razorpay caps this at 40 chars)

  amount   Int // PAISE, not rupees
  currency String @default("INR")

  status  PaymentStatus @default(CREATED)
  method  String? // upi / card / netbanking / wallet, as reported by Razorpay
  email   String?
  contact String?

  errorCode        String?
  errorDescription String?

  authorizedAt DateTime?
  capturedAt   DateTime?
  failedAt     DateTime?

  refundedAmount Int @default(0) // PAISE

  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  razorpayRefundId String  @unique
  amount           Int // PAISE
  status           String // pending / processed / failed, as reported by Razorpay
  reason           String?

  initiatedBy String? // admin User id; null when refunded automatically (late auth)
  admin       User?   @relation("RefundAdmin", fields: [initiatedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
}

/// Every webhook delivery we accept. `eventId` is Razorpay's x-razorpay-event-id
/// and is the idempotency key: Razorpay retries a failed delivery up to 24 times.
model WebhookEvent {
  id       String @id @default(cuid())
  provider String @default("razorpay")
  eventId  String @unique
  event    String // "payment.captured", "refund.failed", ...
  payload  Json

  // Lifted out of the payload so the admin UI can build a per-payment timeline.
  // Filtering a Json column on nested content is not something Postgres/Prisma
  // will do with an index, hence real columns.
  razorpayOrderId   String?
  razorpayPaymentId String?

  processedAt DateTime?
  error       String?   @db.Text
  receivedAt  DateTime  @default(now())

  @@index([event])
  @@index([receivedAt])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

model Payout {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Int
  paidByAdmin String
  admin       User      @relation("PayoutAdmin", fields: [paidByAdmin], references: [id])
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

// ---------- Reports & contact ----------

enum ReportTargetType {
  QUESTION
  COMMENT
  RESOURCE
  REVIEW
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  targetId   String
  contextUrl String? // page the report was filed from, for the admin to jump to the content
  reason     String
  details    String?          @db.Text
  status     ReportStatus     @default(OPEN)

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())

  @@unique([targetType, targetId, reporterId])
  @@index([status])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved])
}

// ---------- Assessment engine (diagnostic tests, e.g. "JAM Physics") ----------
// A `Test` is one free assessment. Anyone can take it without an account —
// see AssessmentAttempt.userId. Designed to scale to multiple tests: a Test
// is config, not a hardcoded flow.

enum AssessmentQuestionSection {
  PROFILE // "which year are you in", "prep level" — no correct answer
  CONTENT // actual subject questions, scored
}

model Test {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  subject         String
  description     String?  @db.Text
  durationMinutes Int      @default(15)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([published])
}

model AssessmentQuestion {
  id      String                    @id @default(cuid())
  testId  String
  test    Test                      @relation(fields: [testId], references: [id], onDelete: Cascade)
  section AssessmentQuestionSection @default(CONTENT)

  // For CONTENT questions this is the subject topic (e.g. "Rotational
  // Mechanics") used for scoring breakdown and mentor matching. For PROFILE
  // questions it's a stable key (e.g. "prep_level") the admin assigns so the
  // study-plan generator can read it back — same table, same admin CRUD,
  // per the "controlled from admin" requirement.
  topic String

  prompt   String  @db.Text
  imageUrl String?

  // [{ id: "a", label: "..." }, ...]. Single-select for both sections in v1.
  options          Json
  correctOptionIds String[] @default([]) // empty for PROFILE questions

  marks         Int     @default(4)
  negativeMarks Int     @default(1)
  order         Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses AttemptResponse[]

  @@index([testId, section, order])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

model AssessmentAttempt {
  id     String @id @default(cuid())
  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  // Null until claimed by a logged-in user. Anonymous attempts are fully
  // usable — the result page carries the attemptId, and signing in from
  // there claims it. No account required to take the test.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?

  // Marketing attribution only — not used for anon/account linking.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  responses AttemptResponse[]
  result    AttemptResult?

  @@index([testId])
  @@index([userId])
}

model AttemptResponse {
  id         String             @id @default(cuid())
  attemptId  String
  attempt    AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionIds String[] @default([])
  isCorrect         Boolean?
  marksAwarded      Int?

  createdAt DateTime @default(now())

  @@unique([attemptId, questionId])
}

model AttemptResult {
  id        String            @id @default(cuid())
  attemptId String            @unique
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  totalScore     Int
  maxScore       Int
  topicBreakdown Json // TopicStat[] — see src/lib/assessment/types.ts
  strengths      String[]
  weaknesses     String[]

  // Answers to PROFILE questions, e.g. { "prep_level": "Just starting out" }.
  // Captured at submit time so study-plan generation doesn't need to rejoin
  // responses later.
  profileAnswers Json?

  // Null until the signed-in owner unlocks it (the account-creation hook —
  // see the results page). Generated on demand, not at submit time, so
  // anonymous test-takers who never sign up never cost an AI call.
  // Never the source of truth for the score itself. See src/lib/ai/study-plan.ts.
  studyPlan Json?

  // DEPRECATED — no longer read or written. Mentors used to be frozen into
  // this column at submit time, which meant a result opened three weeks later
  // still advertised whoever happened to be newest on test day, and silently
  // showed fewer (or none) once one of them was unverified. The results page
  // and the PDF both pick mentors at view time now. Kept only so dropping it
  // is a separate, deliberate migration.
  recommendedMentorIds String[] @default([])

  generatedAt DateTime @default(now())
}

// ---------- Notifications ----------

enum NotificationChannel {
  EMAIL
  TELEGRAM // not wired yet — the column exists so adding it is additive
}

enum NotificationEvent {
  BOOKING_CONFIRMED
  SESSION_REMINDER_24H
  SESSION_REMINDER_30M
  SESSION_FEEDBACK
}

enum NotificationStatus {
  PENDING // queued, not yet handed to a provider
  SENT
  FAILED // gave up after MAX_ATTEMPTS — see src/lib/notifications/dispatch.ts
  SKIPPED // deliberately not sent: no address on this channel, or no longer relevant
}

/// One outbound message we intend to send, queued in our own database.
///
/// This is a transactional outbox, and the shape is deliberate: the row is
/// written inside the same transaction as the booking change that warrants it,
/// so the two cannot disagree — no confirmed booking without its notification
/// queued, and no notification for a booking that rolled back.
///
/// Nothing here ever talks to an email provider. A cron tick drains the table
/// afterwards (src/app/api/cron/notifications/route.ts), which is what keeps a
/// provider outage away from the booking flow entirely: if Resend is down, rows
/// sit here and are retried. Email is not allowed to fail a booking, block a
/// user, or roll anything back.
///
/// Delivery is at-least-once, not exactly-once. A process that dies between
/// "provider accepted" and "row marked SENT" will retry; the provider-side
/// idempotency key in dispatch.ts is what stops that becoming a duplicate
/// inbox entry.
model Notification {
  id String @id @default(cuid())

  event   NotificationEvent
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  /// Who to tell — a user, never an address. Addresses are resolved at send
  /// time, so a mentee who adds their email after booking still gets the
  /// reminder, and a changed address is honoured rather than frozen in.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What it is about. Nullable so account-level notifications can live here
  /// later without a schema change.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Earliest this may be sent. `now()` for an immediate message; a future
  /// timestamp is the entire scheduling mechanism — a T-30m reminder is just a
  /// row with `sendAfter = scheduledStartAt - 30 minutes`.
  sendAfter DateTime @default(now())

  /// Doubles as an optimistic lock: the drain claims a row by incrementing
  /// this conditionally, so two overlapping ticks cannot both send it.
  attempts Int @default(0)

  lastError String?   @db.Text
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The idempotency guard. A Razorpay webhook delivered three times tries to
  /// enqueue the same confirmation three times; this makes the second and third
  /// a no-op instead of three emails. Rows with a null bookingId do not collide
  /// under Postgres NULL semantics, which is what leaves room for
  /// account-level notifications later.
  @@unique([bookingId, userId, event, channel])
  /// The drain query rides this: PENDING rows whose sendAfter has passed.
  @@index([status, sendAfter])
}

// ---------- Video call attendance ----------

enum MeetingParticipantRole {
  MENTEE
  MENTOR
  ADMIN // support looking in on a call; never counted as a party to the session
}

/// One person's arrival at one booking's video call.
///
/// The question this answers is the unglamorous one that decides whether the
/// product works: of the sessions people paid for, how many did both sides
/// actually turn up to? Reviews only ever come from the calls that went well,
/// and a "did this happen?" prompt is a self-report; this is the one signal
/// nobody has to volunteer.
///
/// What it records is the moment we handed this person a room URL — the click
/// on "Join video call", written by src/app/bookings/[id]/join/route.ts, which
/// is the only route through which a room URL is ever minted. That makes it
/// exact about intent to join and silent about what happened next: it cannot
/// see whether their camera worked, how long they stayed, or whether they sat
/// in the room alone. Presence inside the call is a different mechanism (the
/// Jitsi iframe API, reporting back from inside the room) and would sit
/// alongside these columns rather than replace them.
///
/// One row per person per booking — the timestamps and the counter carry the
/// repeats, because a call rejoined three times after a dropped connection is
/// one person attending, not three.
model MeetingAttendance {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which side of the session this person was on, as of their first join.
  /// Snapshotted rather than re-derived, so a mentor who later loses their
  /// profile does not turn every call they ran into a mentee's.
  role MeetingParticipantRole

  /// First and most recent arrival. The gap between the two is the closest
  /// thing to "how long were they around for" that a join click can give.
  firstJoinedAt DateTime @default(now())
  lastJoinedAt  DateTime @default(now())

  /// Arrivals, including rejoins. A high count on a short session usually
  /// means a bad connection, which is worth being able to see.
  joins Int @default(1)

  /// Whether this person was handed the room as its moderator. Always true for
  /// the mentor on JaaS; on public Jitsi it records our intent, since the
  /// instance itself decides by arrival order.
  moderator Boolean @default(false)

  /// How early they arrived, relative to the session's start — negative for
  /// before it, positive for after. Kept as a number rather than recomputed on
  /// read so the "how many mentors show up late?" question survives a booking
  /// being rescheduled.
  joinedOffsetSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per person per call — the upsert in
  /// src/lib/bookings/attendance.ts turns a rejoin into an increment.
  @@unique([bookingId, userId])
  @@index([bookingId])
}
