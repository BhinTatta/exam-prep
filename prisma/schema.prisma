// Prisma schema — Exam Prep Platform
// Postgres via Neon. Run `npx prisma migrate dev` once DATABASE_URL is set.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth (NextAuth Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  MODERATOR
  MENTOR
  ADMIN
}

// Where the student currently is in their JAM/NET/GATE prep journey —
// shown on their profile and used to tailor mentor matching.
enum AcademicStatus {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FINAL_YEAR
  POST_GRADUATE
  DROPPER
  WORKING_PROFESSIONAL
  OTHER
}

model User {
  id              String         @id @default(cuid())
  email           String?        @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  bio             String?        @db.Text
  collegeName     String?
  academicStatus  AcademicStatus?
  role            Role           @default(USER)
  telegramId      String?        @unique
  firebaseUid     String?        @unique
  termsAcceptedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  accounts Account[]
  sessions Session[]

  resources       Resource[]
  questions       Question[]
  comments        Comment[]
  commentUpvotes  CommentUpvote[]
  mentorProfile   MentorProfile?
  bookingsAsMentee Booking[]      @relation("MenteeBookings")
  verifiedMentors  MentorProfile[] @relation("MentorVerifier")
  paymentsVerified Booking[]      @relation("PaymentVerifier")
  payoutsPaid      Payout[]       @relation("PayoutAdmin")
  reports          Report[]
  assessmentAttempts AssessmentAttempt[]

  @@index([role])
}

// ---------- Resources ----------

model Resource {
  id         String   @id @default(cuid())
  title      String
  url        String
  category   String // institute | books | test-series | pyq — see config/site.ts
  subject    String // "physics" now, extensible
  tags       String[]
  pinned     Boolean  @default(false)
  featured   Boolean  @default(false)
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([subject, category])
}

// ---------- Community Q&A ----------

model Question {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  imageUrl  String?
  subject   String
  pinned    Boolean   @default(false)
  locked    Boolean   @default(false)
  deleted   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]

  @@index([subject])
  @@index([pinned])
}

model Comment {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  upvotes    Int      @default(0)
  deleted    Boolean  @default(false)
  createdAt  DateTime @default(now())

  votes CommentUpvote[]

  @@index([questionId])
}

model CommentUpvote {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

// ---------- Mentor marketplace ----------

model MentorProfile {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute  String
  rank       String? // e.g. AIR / rank proof text
  subjects   String[]
  rate       Int // per-session rate, INR
  upiId      String // for manual payment collection
  proofUrl   String // uploaded proof document (Supabase Storage)
  bio        String?   @db.Text
  verified   Boolean   @default(false)
  verifiedBy String?
  verifier   User?     @relation("MentorVerifier", fields: [verifiedBy], references: [id])
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  availability Availability[]
  bookings     Booking[]

  // Topic tags (e.g. "Rotational Mechanics") used to match this mentor against
  // a mentee's weak topics from an assessment result. Empty until the mentor
  // (or admin) tags them; recommendation logic falls back to "any verified
  // mentor" when no tagged mentor overlaps.
  topics String[] @default([])

  @@index([verified])
}

model Availability {
  id        String        @id @default(cuid())
  mentorId  String
  mentor    MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  startTime String // "HH:mm", 24h
  duration  Int           @default(30) // minutes
  isBooked  Boolean       @default(false)
  createdAt DateTime      @default(now())

  bookings Booking[]

  @@index([mentorId])
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMED
  COMPLETED
  DISPUTED
  CANCELLED
}

model Booking {
  id     String @id @default(cuid())

  menteeId String
  mentee   User   @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)

  mentorId String
  mentor   MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  slotId String
  slot   Availability @relation(fields: [slotId], references: [id])

  status BookingStatus @default(PENDING_PAYMENT)
  amount Int

  utrReference   String?
  paymentProofUrl String?

  meetLink String?

  paymentVerifiedBy String?
  verifier          User?     @relation("PaymentVerifier", fields: [paymentVerifiedBy], references: [id])
  paymentVerifiedAt DateTime?

  menteeConfirmedHappened Boolean? // post-session "did this happen?" prompt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payout Payout?

  @@index([status])
  @@index([menteeId])
  @@index([mentorId])
}

model Payout {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Int
  paidByAdmin String
  admin       User      @relation("PayoutAdmin", fields: [paidByAdmin], references: [id])
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

// ---------- Reports & contact ----------

enum ReportTargetType {
  QUESTION
  COMMENT
  RESOURCE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  targetId   String
  contextUrl String? // page the report was filed from, for the admin to jump to the content
  reason     String
  details    String?          @db.Text
  status     ReportStatus     @default(OPEN)

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())

  @@unique([targetType, targetId, reporterId])
  @@index([status])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved])
}

// ---------- Assessment engine (diagnostic tests, e.g. "JAM Physics") ----------
// A `Test` is one free assessment. Anyone can take it without an account —
// see AssessmentAttempt.userId. Designed to scale to multiple tests: a Test
// is config, not a hardcoded flow.

enum AssessmentQuestionSection {
  PROFILE // "which year are you in", "prep level" — no correct answer
  CONTENT // actual subject questions, scored
}

model Test {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  subject         String
  description     String?  @db.Text
  durationMinutes Int      @default(15)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([published])
}

model AssessmentQuestion {
  id      String                    @id @default(cuid())
  testId  String
  test    Test                      @relation(fields: [testId], references: [id], onDelete: Cascade)
  section AssessmentQuestionSection @default(CONTENT)

  // For CONTENT questions this is the subject topic (e.g. "Rotational
  // Mechanics") used for scoring breakdown and mentor matching. For PROFILE
  // questions it's a stable key (e.g. "prep_level") the admin assigns so the
  // study-plan generator can read it back — same table, same admin CRUD,
  // per the "controlled from admin" requirement.
  topic String

  prompt   String  @db.Text
  imageUrl String?

  // [{ id: "a", label: "..." }, ...]. Single-select for both sections in v1.
  options          Json
  correctOptionIds String[] @default([]) // empty for PROFILE questions

  marks         Int     @default(4)
  negativeMarks Int     @default(1)
  order         Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses AttemptResponse[]

  @@index([testId, section, order])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

model AssessmentAttempt {
  id     String @id @default(cuid())
  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  // Null until claimed by a logged-in user. Anonymous attempts are fully
  // usable — the result page carries the attemptId, and signing in from
  // there claims it. No account required to take the test.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?

  // Marketing attribution only — not used for anon/account linking.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  responses AttemptResponse[]
  result    AttemptResult?

  @@index([testId])
  @@index([userId])
}

model AttemptResponse {
  id        String             @id @default(cuid())
  attemptId String
  attempt   AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question  AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionIds String[] @default([])
  isCorrect         Boolean?
  marksAwarded      Int?

  createdAt DateTime @default(now())

  @@unique([attemptId, questionId])
}

model AttemptResult {
  id        String            @id @default(cuid())
  attemptId String            @unique
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  totalScore     Int
  maxScore       Int
  topicBreakdown Json // TopicStat[] — see src/lib/assessment/types.ts
  strengths      String[]
  weaknesses     String[]

  // Answers to PROFILE questions, e.g. { "prep_level": "Just starting out" }.
  // Captured at submit time so study-plan generation doesn't need to rejoin
  // responses later.
  profileAnswers Json?

  // Null until the signed-in owner unlocks it (the account-creation hook —
  // see the results page). Generated on demand, not at submit time, so
  // anonymous test-takers who never sign up never cost an AI call.
  // Never the source of truth for the score itself. See src/lib/ai/study-plan.ts.
  studyPlan            Json?
  recommendedMentorIds String[] @default([])

  generatedAt DateTime @default(now())
}
