# Copy to .env.local and fill in. Never commit real values.
#
# Prisma's CLI reads `.env`, while Next.js reads `.env.local`. If you run
# `npm run db:migrate` locally, DATABASE_URL / DIRECT_URL also need to be in
# a `.env` file (or exported in your shell).

# --- App ---------------------------------------------------------------
# Public origin, no trailing slash. Used for absolute links and to build the
# Razorpay webhook URL. Must be set in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Neon Postgres) ------------------------------------------
# Both are REQUIRED in Vercel's Production environment: production builds run
# `prisma migrate deploy` before `next build` (see scripts/build.mjs), so the
# schema is migrated before the code that needs it goes live.
DATABASE_URL=            # pooled connection string (hostname contains '-pooler')
DIRECT_URL=              # DIRECT, non-pooled connection — Prisma Migrate runs DDL,
                         # which cannot go through the pooler. Without it, builds fail.

# --- Auth (NextAuth v5) ------------------------------------------------
AUTH_SECRET=             # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=              # HMAC-verifies the Telegram login widget
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Razorpay ----------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys.
# rzp_test_... while testing, rzp_live_... in production.
RAZORPAY_KEY_ID=
# SERVER ONLY. Never expose to the browser, never log, never commit.
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks. 32+ random characters, and it
# must match the secret configured on the webhook endpoint:
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications: email (Resend) -------------------------------------
# Resend dashboard -> API Keys. Scope the key to the sending domain and give it
# "Sending access" only. Without it, development logs emails to the console and
# production fails them loudly rather than pretending to send.
RESEND_API_KEY=
# Must be an address on the VERIFIED SENDING SUBDOMAIN, not the root domain:
# reputation is tracked per-domain, so keeping transactional mail on its own
# subdomain means a spam problem here cannot hurt human mail at the root.
EMAIL_FROM="IITJAM Buddy <noreply@mail.iitjambuddy.com>"
# A real inbox (Cloudflare Email Routing forwards it), so replies reach a person.
EMAIL_REPLY_TO="support@iitjambuddy.com"

# --- Cron ---------------------------------------------------------------
# Guards POST/GET {NEXT_PUBLIC_APP_URL}/api/cron/notifications, which sends due
# email and sweeps lapsed slot holds. 32+ random characters:
#   openssl rand -base64 32
# Send it as an `Authorization: Bearer <secret>` header. Vercel Cron adds this
# header automatically when CRON_SECRET is set; an external pinger
# (cron-job.org, every 5 minutes) has to be configured with it. Unset means the
# endpoint refuses every request — an open drain lets anyone burn the daily
# email quota.
CRON_SECRET=

# --- Storage (Supabase) ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="exam-prep-uploads"

# --- Firebase (email auth) ---------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- AI study plans (optional; falls back to a static plan) -------------
AI_PROVIDER=             # "gemini" | "anthropic"
AI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Seeding (optional) ------------------------------------------------
SEED_ADMIN_EMAIL=
